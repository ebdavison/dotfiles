#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.parse
import urllib.request
from json import JSONDecodeError
from datetime import datetime
from typing import Any
from urllib.error import HTTPError, URLError
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover - Python < 3.11 not supported here
    tomllib = None

def load_config_defaults() -> dict[str, str]:
    config_path = Path.home() / ".config" / "kimai" / "config.toml"
    if tomllib is None or not config_path.is_file():
        return {}
    with config_path.open("rb") as handle:
        data = tomllib.load(handle)
    if not isinstance(data, dict):
        return {}
    defaults: dict[str, str] = {}
    for key in ("url", "token"):
        value = data.get(key, "")
        if value:
            defaults[key] = str(value)
    return defaults


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    defaults = load_config_defaults()
    parser = argparse.ArgumentParser(prog="kimai")
    parser.add_argument("--url", default=os.environ.get("KIMAI_URL", defaults.get("url", "")))
    parser.add_argument("--token", default=os.environ.get("KIMAI_TOKEN", defaults.get("token", "")))
    parser.add_argument("--json", action="store_true")
    subparsers = parser.add_subparsers(dest="command", required=True)

    start = subparsers.add_parser("start")
    start.add_argument("--project", required=True)
    start.add_argument("--activity", required=True)
    start.add_argument("--description", default="")
    start.add_argument("--begin")

    stop = subparsers.add_parser("stop")
    stop.add_argument("--id", required=True)
    stop.add_argument("--end")

    view = subparsers.add_parser("view")
    view.add_argument("entry_id", nargs="?", help="timesheet id for a detailed view")
    view.add_argument("--limit", type=int, default=10)

    return parser.parse_args(argv)


def resolve_settings(args: argparse.Namespace) -> dict[str, str | bool]:
    return {
        "base_url": args.url.rstrip("/"),
        "token": args.token,
        "command": args.command,
        "json": args.json,
    }


def validate_settings(settings: dict[str, str | bool]) -> None:
    if not settings["base_url"]:
        raise RuntimeError("kimai: missing KIMAI_URL or --url")
    if not settings["token"]:
        raise RuntimeError("kimai: missing KIMAI_TOKEN or --token")


def kimai_request(
    base_url: str,
    token: str,
    method: str,
    path: str,
    fields: dict[str, Any] | None = None,
) -> dict:
    url = f"{base_url}/api{path}"
    data = None
    headers = {"Authorization": f"Bearer {token}"}
    try:
        if fields is not None:
            data = urllib.parse.urlencode(fields).encode("utf-8")
            headers["Content-Type"] = "application/x-www-form-urlencoded"
        request = urllib.request.Request(url, data=data, headers=headers, method=method)
        with urllib.request.urlopen(request) as response:
            payload = response.read().decode("utf-8")
        return json.loads(payload) if payload else {}
    except HTTPError as exc:
        raise RuntimeError(f"kimai: HTTP {exc.code} {exc.reason}") from None
    except URLError as exc:
        raise RuntimeError(f"kimai: network error: {exc.reason}") from None
    except JSONDecodeError:
        raise RuntimeError("kimai: invalid JSON response") from None


def start_timesheet(settings: dict[str, str | bool], args: argparse.Namespace) -> dict:
    begin = args.begin or datetime.now().astimezone().isoformat(timespec="seconds")
    return kimai_request(
        str(settings["base_url"]),
        str(settings["token"]),
        "POST",
        "/timesheets",
        {
            "project": args.project,
            "activity": args.activity,
            "description": args.description or "",
            "begin": begin,
        },
    )


def stop_timesheet(settings: dict[str, str | bool], args: argparse.Namespace) -> dict:
    end = args.end or datetime.now().astimezone().isoformat(timespec="seconds")
    return kimai_request(
        str(settings["base_url"]),
        str(settings["token"]),
        "PATCH",
        f"/timesheets/{args.id}",
        {"end": end},
    )


def view_timesheets(settings: dict[str, str | bool], args: argparse.Namespace) -> dict:
    if args.entry_id:
        payload = kimai_request(
            str(settings["base_url"]),
            str(settings["token"]),
            "GET",
            f"/timesheets/{args.entry_id}",
        )
        if isinstance(payload.get("project"), (int, str)) and str(payload["project"]).strip():
            payload["project"] = kimai_request(
                str(settings["base_url"]),
                str(settings["token"]),
                "GET",
                f"/projects/{payload['project']}",
            )
        if isinstance(payload.get("activity"), (int, str)) and str(payload["activity"]).strip():
            payload["activity"] = kimai_request(
                str(settings["base_url"]),
                str(settings["token"]),
                "GET",
                f"/activities/{payload['activity']}",
            )
        return payload
    return kimai_request(
        str(settings["base_url"]),
        str(settings["token"]),
        "GET",
        f"/timesheets/recent?size={args.limit}",
    )


def format_duration(value: Any) -> str:
    if value in (None, ""):
        return ""
    try:
        total_seconds = int(float(value))
    except (TypeError, ValueError):
        return str(value)
    hours, remainder = divmod(abs(total_seconds), 3600)
    minutes, seconds = divmod(remainder, 60)
    prefix = "-" if total_seconds < 0 else ""
    return f"{prefix}{hours:02d}:{minutes:02d}:{seconds:02d}"


def render_timesheets(payload: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return
    rows = payload if isinstance(payload, list) else payload.get("data", [])
    for row in rows:
        print(
            f'{row.get("id", "")}\t{row.get("begin", "")}\t'
            f'{format_duration(row.get("duration", ""))}\t{row.get("description", "")}'
        )


def render_timesheet_detail(payload: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return

    def label_with_id(value: Any) -> str:
        if isinstance(value, dict):
            name = ""
            for key in ("name", "title", "label"):
                text = value.get(key)
                if text:
                    name = str(text)
                    break
            identifier = value.get("id")
            if name and identifier not in (None, ""):
                return f"{name} [{identifier}]"
            if name:
                return name
            if identifier not in (None, ""):
                return f"[{identifier}]"
            return ""
        return str(value or "")

    def company_name() -> str:
        project = payload.get("project") if isinstance(payload.get("project"), dict) else {}
        for candidate in (
            payload.get("customer"),
            payload.get("company"),
            payload.get("client"),
            project.get("customer") if isinstance(project, dict) else None,
            project.get("customerName") if isinstance(project, dict) else None,
            project.get("customer_name") if isinstance(project, dict) else None,
        ):
            text = label_with_id(candidate)
            if text:
                return text
        return ""

    lines = [
        f'ID: {payload.get("id", "")}',
        f'Company: {company_name()}',
        f'Project: {label_with_id(payload.get("project"))}',
        f'Activity: {label_with_id(payload.get("activity"))}',
        f'Begin: {payload.get("begin", "")}',
        f'End: {payload.get("end", "")}',
        f'Duration: {format_duration(payload.get("duration", ""))}',
        f'Description: {payload.get("description", "")}',
    ]
    print("\n".join(lines))


def render_result(payload: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return
    if isinstance(payload, list):
        render_timesheets(payload, False)
        return
    if isinstance(payload.get("data"), list):
        render_timesheets(payload, False)
        return
    print(payload.get("id", ""))


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    settings = resolve_settings(args)
    try:
        validate_settings(settings)
        if args.command == "start":
            render_result(start_timesheet(settings, args), args.json)
        elif args.command == "stop":
            render_result(stop_timesheet(settings, args), args.json)
        elif args.command == "view":
            payload = view_timesheets(settings, args)
            if args.entry_id:
                render_timesheet_detail(payload, args.json)
            else:
                render_result(payload, args.json)
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
