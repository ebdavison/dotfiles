#!/usr/bin/env bash
set -euo pipefail

profiles=(personal work)

usage() {
  cat <<'USAGE'
Usage: install-agent-tools [--profile personal|work|all]

Check for Node.js 22.x/npm, Pi, Herdr, Obsidian Headless, Codex, and Claude
Code. For every missing or out-of-policy tool, show its install command and
ask before installing it. After Pi is available, reconcile the selected Pi
profile extensions from settings.json.
USAGE
}

validate_home() {
  if [[ -z "${HOME:-}" || "$HOME" == "/" ]]; then
    echo "Refusing to run with unsafe HOME: ${HOME:-<empty>}" >&2
    exit 2
  fi
}

validate_platform() {
  if [[ "$(uname -s)" != "Linux" ]]; then
    echo "install-agent-tools supports Linux only." >&2
    exit 2
  fi
}

select_profiles() {
  local selected="all"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        if [[ $# -lt 2 ]]; then
          echo "--profile requires personal, work, or all" >&2
          exit 2
        fi
        selected="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown argument: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
  done

  case "$selected" in
    all)
      profiles=(personal work)
      ;;
    personal|work)
      profiles=("$selected")
      ;;
    *)
      echo "Invalid profile: $selected" >&2
      exit 2
      ;;
  esac
}

prompt_install() {
  local label="$1"
  local command="$2"
  local answer

  printf '%s is missing. Install with:\n  %s\nInstall %s? [y/N]: ' "$label" "$command" "$label" >&2
  if ! IFS= read -r answer; then
    echo "Skipped $label (no answer received)." >&2
    return 1
  fi

  case "$answer" in
    y|Y|yes|YES)
      return 0
      ;;
    *)
      echo "Skipped $label." >&2
      return 1
      ;;
  esac
}

require_command() {
  local command="$1"
  local label="$2"

  if command -v "$command" >/dev/null 2>&1; then
    return 0
  fi

  echo "Cannot install $label: required command '$command' is unavailable." >&2
  return 1
}

verify_installed() {
  local command="$1"
  local label="$2"

  hash -r
  if command -v "$command" >/dev/null 2>&1; then
    echo "Installed $label."
    return 0
  fi

  echo "$label installation completed but '$command' is still unavailable on PATH." >&2
  return 1
}

nodejs_22_ready() {
  local version

  if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
    return 1
  fi

  npm --version >/dev/null 2>&1 || return 1
  version="$(node --version 2>/dev/null || true)"
  [[ "$version" =~ ^v22\.[0-9]+\.[0-9]+$ ]]
}

os_release_value() {
  local key="$1"
  local os_release="${INSTALL_AGENT_TOOLS_OS_RELEASE:-/etc/os-release}"
  local line value

  [[ -r "$os_release" ]] || return 1

  while IFS= read -r line; do
    case "$line" in
      "$key"=*)
        value="${line#*=}"
        value="${value#\"}"
        value="${value%\"}"
        printf '%s\n' "$value"
        return 0
        ;;
    esac
  done < "$os_release"

  return 1
}

node_package_manager() {
  local id id_like
  id="$(os_release_value ID || true)"
  id_like="$(os_release_value ID_LIKE || true)"

  case " $id $id_like " in
    *" debian "*|*" ubuntu "*)
      printf '%s\n' "apt-get"
      ;;
    *" fedora "*|*" rhel "*|*" centos "*|*" rocky "*|*" almalinux "*)
      printf '%s\n' "dnf"
      ;;
    *)
      return 1
      ;;
  esac
}

ensure_nodejs_22() {
  local package_manager setup_url install_command setup_script

  if nodejs_22_ready; then
    echo "Found Node.js 22.x and npm: $(node --version)"
    return 0
  fi

  package_manager="$(node_package_manager)" || {
    echo "Unsupported Linux distribution for Node.js 22 installation." >&2
    return 2
  }

  case "$package_manager" in
    apt-get)
      setup_url="https://deb.nodesource.com/setup_22.x"
      install_command=$'curl -fsSL https://deb.nodesource.com/setup_22.x -o <temporary NodeSource setup script>\nsudo -E bash <temporary NodeSource setup script>\nsudo apt-get install -y nodejs'
      ;;
    dnf)
      setup_url="https://rpm.nodesource.com/setup_22.x"
      install_command=$'curl -fsSL https://rpm.nodesource.com/setup_22.x -o <temporary NodeSource setup script>\nsudo -E bash <temporary NodeSource setup script>\nsudo dnf install -y nodejs'
      ;;
  esac

  echo "Node.js 22.x and npm are missing or out of policy." >&2
  if ! prompt_install "Node.js 22.x and npm" "$install_command"; then
    return 0
  fi

  require_command curl "Node.js 22.x" || return 1
  require_command sudo "Node.js 22.x" || return 1
  require_command "$package_manager" "Node.js 22.x" || return 1

  setup_script="$(mktemp "${TMPDIR:-/tmp}/nodesource-setup-22.XXXXXX")"
  if ! curl -fsSL "$setup_url" -o "$setup_script"; then
    rm -f "$setup_script"
    return 1
  fi
  if ! sudo -E bash "$setup_script"; then
    rm -f "$setup_script"
    return 1
  fi
  rm -f "$setup_script"

  if ! sudo "$package_manager" install -y nodejs; then
    return 1
  fi
  hash -r
  if nodejs_22_ready; then
    echo "Installed Node.js $(node --version) and npm."
    return 0
  fi

  echo "Node.js installation completed but Node.js 22.x and npm are unavailable." >&2
  return 1
}

ensure_npm_tool() {
  local command="$1"
  local label="$2"
  local package="$3"
  local install_command="npm install -g $package"

  if command -v "$command" >/dev/null 2>&1; then
    echo "Found $label: $(command -v "$command")"
    return 0
  fi

  if ! prompt_install "$label" "$install_command"; then
    return 0
  fi

  require_command npm "$label"
  npm install -g "$package"
  verify_installed "$command" "$label"
}

ensure_herdr() {
  local install_command='curl -fsSL https://herdr.dev/install.sh | sh'

  if command -v herdr >/dev/null 2>&1; then
    echo "Found Herdr: $(command -v herdr)"
    return 0
  fi

  if ! prompt_install "Herdr" "$install_command"; then
    return 0
  fi

  require_command curl "Herdr"
  curl -fsSL https://herdr.dev/install.sh | sh
  verify_installed herdr "Herdr"
}

ensure_agent_tools() {
  if nodejs_22_ready; then
    ensure_npm_tool pi "Pi" "@earendil-works/pi-coding-agent"
  else
    echo "Skipping npm-backed agent tools: Node.js 22.x and npm are unavailable." >&2
  fi

  ensure_herdr

  if nodejs_22_ready; then
    ensure_npm_tool ob "Obsidian Headless" "obsidian-headless"
    ensure_npm_tool codex "Codex" "@openai/codex"
    ensure_npm_tool claude "Claude Code" "@anthropic-ai/claude-code"
  fi
}

profile_dir() {
  local profile="$1"
  printf '%s\n' "$HOME/.pi-$profile"
}

reconcile_profile() {
  local profile="$1"
  local dir
  dir="$(profile_dir "$profile")"

  if [[ ! -f "$dir/settings.json" ]]; then
    echo "WARN: missing $dir/settings.json; skipping $profile" >&2
    return 0
  fi

  mkdir -p "$dir"
  echo "Reconciling Pi packages for $profile ($dir)"
  PI_CODING_AGENT_DIR="$dir" PI_ENV="$profile" pi update --extensions
}

reconcile_pi_profiles() {
  if ! nodejs_22_ready || ! command -v pi >/dev/null 2>&1; then
    echo "Pi package reconciliation skipped: pi is unavailable." >&2
    return 0
  fi

  local profile
  for profile in "${profiles[@]}"; do
    reconcile_profile "$profile"
  done
}

main() {
  validate_home
  validate_platform
  local node_setup_status

  select_profiles "$@"
  if ensure_nodejs_22; then
    :
  else
    node_setup_status="$?"
    if [[ "$node_setup_status" == "2" ]]; then
      exit 2
    fi
    echo "Node.js setup failed; continuing with non-npm tools only." >&2
  fi
  ensure_agent_tools
  reconcile_pi_profiles

  echo "Agent tool setup complete. Restart Pi or run /reload in existing sessions."
  echo "Obsidian Headless is installed only; run 'ob login' and configure a vault manually."
}

main "$@"
